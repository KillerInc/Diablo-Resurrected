#include <windows.h>

1 VERSIONINFO
FILEVERSION @REINCARNATED_VERSION_MAJOR@,@REINCARNATED_VERSION_MINOR@,@REINCARNATED_VERSION_PATCH@,0
PRODUCTVERSION @REINCARNATED_VERSION_MAJOR@,@REINCARNATED_VERSION_MINOR@,@REINCARNATED_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS VS_FF_PRERELEASE
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "KillerInc\0"
      VALUE "FileDescription", "Diablo Reincarnated\0"
      VALUE "FileVersion", "@REINCARNATED_DISPLAY_VERSION@\0"
      VALUE "InternalName", "Diablo Reincarnated\0"
      VALUE "OriginalFilename", "Diablo Reincarnated.exe\0"
      VALUE "ProductName", "Diablo Reincarnated\0"
      VALUE "ProductVersion", "@REINCARNATED_DISPLAY_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
