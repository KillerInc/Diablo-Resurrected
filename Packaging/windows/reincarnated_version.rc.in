#include <windows.h>

1 VERSIONINFO
FILEVERSION @REINCARNATED_VERSION_MAJOR@,@REINCARNATED_VERSION_MINOR@,@REINCARNATED_VERSION_PATCH@,0
PRODUCTVERSION @REINCARNATED_VERSION_MAJOR@,@REINCARNATED_VERSION_MINOR@,@REINCARNATED_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
FILEFLAGS VS_FF_PRERELEASE | VS_FF_DEBUG
#else
FILEFLAGS VS_FF_PRERELEASE
#endif
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "KillerInc\0"
      VALUE "FileDescription", "@REINCARNATED_EXECUTABLE_NAME@\0"
      VALUE "FileVersion", "@REINCARNATED_DISPLAY_VERSION@\0"
      VALUE "InternalName", "@REINCARNATED_EXECUTABLE_NAME@\0"
      VALUE "OriginalFilename", "@REINCARNATED_EXECUTABLE_NAME@.exe\0"
      VALUE "ProductName", "@REINCARNATED_EXECUTABLE_NAME@\0"
      VALUE "ProductVersion", "@REINCARNATED_DISPLAY_VERSION@\0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0409, 1200
  END
END
